+/* Test hook, plain ticks only: before the pin write, on a pseudo-random subset of the ticks, wait PS_INJ_K * 4
+ * core cycles. comp 1: r6, r7 free, the word is in r11; comp 0: the word is in r7, its address in r6 (both kept). */
+	.macro	INJECT comp
+	.if	\comp == 0
+	str	r6, [sp, #PS_TMP0]
+	str	r7, [sp, #PS_TMP1]
+	.endif
+	ldr	r6, [sp, #PS_LFSR]
+	lsls	r7, r6, #13
+	eors	r6, r7
+	lsrs	r7, r6, #17
+	eors	r6, r7
+	lsls	r7, r6, #5
+	eors	r6, r7
+	str	r6, [sp, #PS_LFSR]
+	ldr	r7, [sp, #PS_INJ_MASK]
+	tst	r6, r7
+	bne	.L_inj_done\@
+	ldr	r6, [sp, #PS_INJ_K]
+	cmp	r6, #0
+	beq	.L_inj_done\@
+	ldr	r7, [sp, #PS_INJ_MODE]
+	cmp	r7, #0
+	beq	.L_inj_go\@
