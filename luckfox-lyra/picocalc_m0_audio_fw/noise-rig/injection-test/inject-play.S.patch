+	ldr	r6, [sp, #PS_INJ_MODE]
+	cmp	r6, #1
+	bne	.L_inj_m2\@
+	bpl	.L_inj_done\@			@ mode 1: only writes with B2 high
+	b	.L_inj_go\@
+.L_inj_m2\@:
+	bmi	.L_inj_done\@			@ mode 2: only writes with B2 low
+.L_inj_go\@:
+	ldr	r7, [sp, #PS_INJ_N]
+	adds	r7, #1
+	str	r7, [sp, #PS_INJ_N]
+	ldr	r6, [sp, #PS_INJ_K]
+.L_inj_loop\@:
+	subs	r6, #1
+	bne	.L_inj_loop\@
+.L_inj_done\@:
+	.if	\comp == 0
+	ldr	r6, [sp, #PS_TMP0]
+	ldr	r7, [sp, #PS_TMP1]
+	.endif
+	.endm
